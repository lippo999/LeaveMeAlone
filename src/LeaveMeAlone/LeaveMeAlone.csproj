<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LeaveMeAlone</RootNamespace>
    <AssemblyName>LeaveMeAlone</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <!-- Allows `dotnet restore` to run on non-Windows hosts; building WPF still requires Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon (TrayIcon.cs imports it explicitly). Its implicit
         global usings would make WPF names like Application/TextBox/Brush ambiguous everywhere. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window/tray icon + sidebar logo (pack://application:,,,/Assets/...). Regenerate with tools/make_icon.ps1. -->
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

</Project>
