<UserControl x:Class="LeaveMeAlone.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext: LogViewModel. Neutral accent: Logs is a system page, not a feature. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="Accent" Color="#C9D1DE"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#1C222C"/>
        <SolidColorBrush x:Key="AccentLine" Color="#334054"/>
    </UserControl.Resources>

    <Grid Margin="36,30,36,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="SYSTEM  ·  ACTIVITY" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextFaint}"/>
                <TextBlock Text="Logs" Style="{StaticResource Display}" Margin="0,6,0,0"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Everything the app did — switches, unblocks, firewall and system commands — with full error details. Hover a line to see its details."/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource SegmentHost}" VerticalAlignment="Bottom" Margin="24,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AllTab" GroupName="LogFilter" Content="All" IsChecked="True"
                                 Style="{StaticResource Segment}" Checked="Filter_Checked"/>
                    <RadioButton x:Name="ProblemsTab" GroupName="LogFilter" Content="{Binding ProblemsLabel}"
                                 Style="{StaticResource Segment}" Checked="Filter_Checked"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Entries -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,22,0,0">
            <Grid>
                <ListBox ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0" Margin="8"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="row" Padding="10,6" CornerRadius="7" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{StaticResource SurfaceAlt}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Details}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Time}" Style="{StaticResource Mono}" Foreground="{StaticResource TextFaint}"/>
                                <TextBlock x:Name="level" Grid.Column="1" Text="{Binding Level}" Style="{StaticResource Mono}"
                                           FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Source}" Style="{StaticResource Mono}" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="message" Grid.Column="3" Text="{Binding Message}" Style="{StaticResource Mono}" TextWrapping="Wrap"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDebug}" Value="True">
                                    <Setter TargetName="message" Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    <Setter TargetName="level" Property="Foreground" Value="{StaticResource TextFaint}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                    <Setter TargetName="level" Property="Foreground" Value="{StaticResource Warn}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter TargetName="level" Property="Foreground" Value="{StaticResource Danger}"/>
                                    <Setter TargetName="message" Property="Foreground" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="Nothing logged yet." Style="{StaticResource Muted}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- Actions -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Copy" Click="Copy_Click" Style="{StaticResource BtnBase}" Margin="8,0,0,0"
                        ToolTip="Copy the lines shown above (with details) to the clipboard"/>
                <Button Content="Open folder" Click="OpenFolder_Click" Style="{StaticResource BtnBase}" Margin="8,0,0,0"
                        ToolTip="Daily log files are kept here"/>
                <Button Content="Clear" Click="Clear_Click" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"
                        ToolTip="Clear this view (files on disk are kept)"/>
            </StackPanel>
            <TextBlock Text="{Binding Folder}" Style="{StaticResource Mono}" Foreground="{StaticResource TextFaint}" FontSize="11"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</UserControl>
