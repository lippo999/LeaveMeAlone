<Window x:Class="LeaveMeAlone.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LeaveMeAlone.Views"
        Title="LeaveMeAlone" Height="720" Width="1100"
        MinHeight="560" MinWidth="900"
        Icon="/Assets/app.ico"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource FontUi}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,24,18,18">

                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,0">
                    <Image Source="/Assets/app.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LeaveMeAlone" Style="{StaticResource H2}" FontSize="16"/>
                        <TextBlock Text="your network, your rules" Style="{StaticResource Muted}" FontSize="11"
                                   Foreground="{StaticResource TextFaint}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Footer: update notice + autostart + admin state -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border x:Name="UpdateCard" CornerRadius="12" Padding="14,12" Margin="0,0,0,10"
                            Background="{StaticResource SignalSoft}" BorderBrush="{StaticResource SignalLine}" BorderThickness="1"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="UPDATE" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Signal}"/>
                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="13"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0">
                                <Run Text="{Binding Subtitle, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Hyperlink Click="ReleaseNotes_Click" Foreground="{StaticResource Signal}">What's new</Hyperlink>
                            </TextBlock>
                            <Button Click="Update_Click" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Update and restart">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
                                        <Setter Property="Content" Value="Update &amp; restart"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Busy}" Value="True">
                                                <Setter Property="Content" Value="Downloading…"/>
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12" Padding="14,12" Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <DockPanel>
                            <ToggleButton x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          VerticalAlignment="Center" Click="Startup_Click"
                                          AutomationProperties.Name="Start with Windows"/>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Start with Windows" Foreground="{StaticResource Text}" FontSize="13"/>
                                <TextBlock Text="Keeps relays running" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="8,14,0,0">
                        <Ellipse x:Name="AdminDot" Width="7" Height="7" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AdminText" Style="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Version + manual update check -->
                    <StackPanel x:Name="VersionRow" Margin="8,6,0,0">
                        <TextBlock x:Name="VersionLine" FontSize="11" Foreground="{StaticResource TextFaint}">
                            <Run Text="{Binding VersionText, Mode=OneWay}"/>
                            <Run x:Name="CheckSeparator" Text=" · "/>
                            <Hyperlink x:Name="CheckLink" Click="CheckForUpdates_Click" Foreground="{StaticResource TextMuted}"
                                       IsEnabled="{Binding CanCheckNow}" AutomationProperties.Name="Check for updates">
                                <Run Text="Check for updates"/>
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{Binding CheckStatus}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CheckStatus}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation: the two features, side by side as equals -->
                <StackPanel Margin="0,34,0,0">
                    <TextBlock Text="TOOLS" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextFaint}" Margin="8,0,0,10"/>

                    <RadioButton x:Name="NavBlock" GroupName="Nav" Style="{StaticResource NavItem}" Tag="{StaticResource Ember}"
                                 IsChecked="True" Checked="Nav_Checked" AutomationProperties.Name="Block">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8" VerticalAlignment="Center"
                                  Stroke="{StaticResource Ember}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M9,2 A7,7 0 1 1 8.99,2 Z M4.1,4.1 L13.9,13.9"/>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                <TextBlock Text="Block" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Ellipse Grid.Column="2" Width="7" Height="7" Fill="{StaticResource Ember}" VerticalAlignment="Center"
                                     Visibility="{Binding AnyBlocking, Converter={StaticResource BoolToVis}}"
                                     ToolTip="Something is blocked right now"/>
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="NavUnblock" GroupName="Nav" Style="{StaticResource NavItem}" Tag="{StaticResource Signal}"
                                 Checked="Nav_Checked" AutomationProperties.Name="Unblock">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8" VerticalAlignment="Center"
                                  Stroke="{StaticResource Signal}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M2,9 H15 M11,5 L15,9 L11,13 M7,1.5 V5.5 M7,12.5 V16.5"/>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                <TextBlock Text="Unblock" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Ellipse Grid.Column="2" Width="7" Height="7" Fill="{StaticResource Signal}" VerticalAlignment="Center"
                                     Visibility="{Binding HasActive, Converter={StaticResource BoolToVis}}"
                                     ToolTip="Some domains are rerouted right now"/>
                        </Grid>
                    </RadioButton>

                    <TextBlock Text="SYSTEM" Style="{StaticResource Eyebrow}" Foreground="{StaticResource TextFaint}" Margin="8,22,0,10"/>

                    <RadioButton x:Name="NavLogs" GroupName="Nav" Style="{StaticResource NavItem}" Tag="{StaticResource TextMuted}"
                                 Checked="Nav_Checked" AutomationProperties.Name="Logs">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.8" VerticalAlignment="Center"
                                  Stroke="{StaticResource TextMuted}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M2,3 H16 M2,7.5 H12 M2,12 H16 M2,16.5 H9"/>
                            <TextBlock Grid.Column="1" Text="Logs" FontSize="14" FontWeight="SemiBold" Margin="12,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <Border Grid.Column="2" CornerRadius="8" Padding="6,1" Background="{StaticResource DangerSoft}"
                                    VerticalAlignment="Center" ToolTip="Warnings and errors this session">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProblemCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ProblemCount}" Foreground="{StaticResource Danger}" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Pages ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Elevation banner (only when not admin) -->
            <Border x:Name="BannerPanel" Grid.Row="0" Margin="36,20,36,0" CornerRadius="10" Padding="14,10"
                    Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource Warn}" BorderThickness="1">
                <TextBlock Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                           Text="Running without administrator rights — switches are disabled. Close the app, start it again and choose 'Yes' at the prompt."/>
            </Border>

            <local:BlockView x:Name="BlockPage" Grid.Row="1">
                <local:BlockView.RenderTransform>
                    <TranslateTransform/>
                </local:BlockView.RenderTransform>
            </local:BlockView>
            <local:UnblockView x:Name="UnblockPage" Grid.Row="1" Visibility="Collapsed">
                <local:UnblockView.RenderTransform>
                    <TranslateTransform/>
                </local:UnblockView.RenderTransform>
            </local:UnblockView>
            <local:LogView x:Name="LogPage" Grid.Row="1" Visibility="Collapsed">
                <local:LogView.RenderTransform>
                    <TranslateTransform/>
                </local:LogView.RenderTransform>
            </local:LogView>
        </Grid>
    </Grid>
</Window>
