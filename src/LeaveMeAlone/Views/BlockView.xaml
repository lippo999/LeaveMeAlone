<UserControl x:Class="LeaveMeAlone.Views.BlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LeaveMeAlone.Views">

    <!-- DataContext: MainViewModel. Accent = Ember (Block). -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="Accent" Color="{StaticResource EmberColor}"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#2A1712"/>
        <SolidColorBrush x:Key="AccentLine" Color="#6A2F21"/>
    </UserControl.Resources>

    <Grid>
        <!-- Atmosphere: a warm glow from the top-right corner -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="0.8" RadiusY="0.9">
                    <GradientStop Color="#26FF6B4A" Offset="0"/>
                    <GradientStop Color="#00FF6B4A" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="36,30,36,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="BLOCK  ·  WINDOWS FIREWALL" Style="{StaticResource Eyebrow}"/>
                    <TextBlock Text="Keep apps offline" Style="{StaticResource Display}" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Flip a switch to cut a launcher off the internet — handy for offline mode. Only the app's own rules are touched, never your existing firewall setup."/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource SegmentHost}" VerticalAlignment="Bottom" Margin="24,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="QuickTab" GroupName="BlockMode" Content="Quick" IsChecked="True"
                                     Style="{StaticResource Segment}"/>
                        <RadioButton x:Name="CustomTab" GroupName="BlockMode" Content="Custom"
                                     Style="{StaticResource Segment}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <local:BusyBar Grid.Row="1" Margin="0,22,0,0"/>

            <!-- ============ QUICK ============ -->
            <ScrollViewer Grid.Row="2" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsChecked, ElementName=QuickTab, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding QuickItems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="card" CornerRadius="14" Padding="18,16" Margin="0,0,0,10"
                                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="mono" Width="42" Height="42" CornerRadius="11"
                                                Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                            <TextBlock x:Name="monoText" Text="{Binding Initial}" FontFamily="{StaticResource FontDisplay}"
                                                       FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                                                <Border Style="{StaticResource Chip}" Background="{StaticResource SurfaceAlt}" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource ChipText}"
                                                               Foreground="{StaticResource TextFaint}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="status" Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Customize" Click="Customize_Click"
                                                Style="{StaticResource BtnGhost}" Margin="0,0,14,0" VerticalAlignment="Center"
                                                ToolTip="Edit this bundle's programs and servers"
                                                Visibility="{Binding CanCustomize, Converter={StaticResource BoolToVis}}"/>

                                        <ToggleButton Grid.Column="3" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsOn, Mode=OneWay}" Click="QuickSwitch_Click"
                                                      AutomationProperties.Name="{Binding Title}"
                                                      ToolTip="On = blocked (offline)"
                                                      IsEnabled="{Binding DataContext.IsElevated, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                                        <Setter TargetName="card" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                        <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentLine}"/>
                                        <Setter TargetName="mono" Property="Background" Value="{DynamicResource Accent}"/>
                                        <Setter TargetName="mono" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        <Setter TargetName="monoText" Property="Foreground" Value="{StaticResource OnAccent}"/>
                                        <Setter TargetName="status" Property="Foreground" Value="{DynamicResource Accent}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state: nothing detected and no bundles yet -->
                    <Border Padding="24,22">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowQuickEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="No game launchers found" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,14"
                                       Text="Steam, Epic, Ubisoft Connect, EA app, Battle.net, GOG, Riot and Rockstar are detected in their default folders. Installed somewhere else? Build your own bundle."/>
                            <Button Content="Create a bundle" Click="GoCustomNew_Click" Style="{StaticResource BtnPrimary}"
                                    HorizontalAlignment="Left" IsEnabled="{Binding IsElevated}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,8,4,0" Foreground="{StaticResource TextFaint}"
                               Text="Switching a launcher on creates a bundle with its programs. Use Customize (or the Custom tab) to add more programs, servers or IP ranges."/>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ CUSTOM ============ -->
            <Grid Grid.Row="2" Margin="0,18,0,0"
                  Visibility="{Binding IsChecked, ElementName=CustomTab, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bundle list -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="4,0,0,12">
                            <Button DockPanel.Dock="Right" Content="+ New" Click="NewBundle_Click"
                                    Style="{StaticResource BtnPrimary}" Padding="12,6" IsEnabled="{Binding IsElevated}"/>
                            <TextBlock Text="Bundles" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <ListBox x:Name="BundlesList" Grid.Row="1" ItemsSource="{Binding Bundles}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="BundlesList_SelectionChanged" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="row" CornerRadius="10" Padding="12,10" Cursor="Hand"
                                                        Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="row" Property="Background" Value="{StaticResource SurfaceAlt}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="row" Property="Background" Value="{StaticResource SurfaceHover}"/>
                                                        <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}" Click="Toggle_Click"
                                                      AutomationProperties.Name="{Binding Name}"
                                                      IsEnabled="{Binding DataContext.IsElevated, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="14"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="status" Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                            <Setter TargetName="status" Property="Foreground" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Import…" Click="Import_Click" Style="{StaticResource BtnGhost}"
                                    ToolTip="Add bundles from a .json file"/>
                            <Button Content="Export…" Click="Export_Click" Style="{StaticResource BtnGhost}"
                                    ToolTip="Save all bundles to a .json file"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Detail -->
                <Grid Grid.Column="2">
                    <Border x:Name="EmptyPanel" Style="{StaticResource Card}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
                            <TextBlock Text="Pick or create a bundle" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="A bundle is a group of programs and servers that you block with one switch."/>
                        </StackPanel>
                    </Border>

                    <!-- DataContext = selected BundleViewModel (set in code-behind) -->
                    <Border x:Name="DetailPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="Rename" Click="Rename_Click" Style="{StaticResource BtnGhost}"
                                            IsEnabled="{Binding DataContext.IsElevated, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Button Content="Delete" Click="Delete_Click" Style="{StaticResource BtnDanger}"
                                            IsEnabled="{Binding DataContext.IsElevated, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <WrapPanel Grid.Row="1" Margin="0,18,0,12">
                                <Button Content="+ Program" Click="AddProgram_Click" Style="{StaticResource BtnBase}" Margin="0,0,8,8"
                                        ToolTip="Block an .exe from going online"
                                        IsEnabled="{Binding DataContext.IsElevated, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <Button Content="+ IP / server" Click="AddIp_Click" Style="{StaticResource BtnBase}" Margin="0,0,8,8"
                                        ToolTip="Block a remote address or range, optionally one port"
                                        IsEnabled="{Binding DataContext.IsElevated, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <Button Content="+ Detected launcher" Click="AddCommon_Click" Style="{StaticResource BtnBase}" Margin="0,0,8,8"
                                        IsEnabled="{Binding DataContext.IsElevated, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <Button Content="Check live rules" Click="Verify_Click" Style="{StaticResource BtnGhost}" Margin="0,0,8,8"
                                        ToolTip="Count the firewall rules that exist right now for this bundle"
                                        IsEnabled="{Binding DataContext.IsElevated, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </WrapPanel>

                            <ListBox Grid.Row="2" ItemsSource="{Binding Targets}" Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource PlainItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="14,10" Background="{StaticResource SurfaceAlt}"
                                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Remove" Click="RemoveTarget_Click"
                                                        Style="{StaticResource BtnDanger}" VerticalAlignment="Center"
                                                        IsEnabled="{Binding DataContext.IsElevated, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Border DockPanel.Dock="Left" Style="{StaticResource Chip}" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource ChipText}"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Text}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Mono}" Foreground="{StaticResource TextMuted}"
                                                               FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Status line -->
            <DockPanel Grid.Row="3" Margin="2,14,0,0">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusMessage}"/>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
